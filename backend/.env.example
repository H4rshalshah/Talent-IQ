[TEMPLATE]
# ==== App ====
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==== Database (MongoDB) ====
DB_URL=your_mongodb_connection_url

# ==== Background jobs (Inngest) ====
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key

# ==== Stream (video + chat) ====
STREAM_API_KEY=your_stream_api_key
STREAM_API_SECRET=your_stream_api_secret

# ==== Codeforces question bank ====
# Comma-separated emails allowed to trigger POST /api/codeforces/sync.
# When set, the server also runs a periodic sync (every 6h, first at 5 min).
ADMIN_EMAILS=you@example.com

# ==== Clerk (authentication) ====
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET_KEY=your_clerk_secret_key

# ==== AI / LLM (Groq primary, Gemini fallback) ====
# Required for AI interviews, AI code review, performance reports and career roadmap.
# Groq is used first for every task (fast + reliable); when it hits its rate
# limit the backend automatically switches to Gemini until Groq resets (~60s).
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# Optional model overrides:
# GROQ_MODEL=groq/compound-mini
# GEMINI_MODEL=gemini-3.6-flash
#
# Optional per-task provider routing (defaults: all tasks -> groq):
# AI_PROVIDER_INTERVIEW=groq
# AI_PROVIDER_EVALUATION=groq
# AI_PROVIDER_REVIEW=groq
# AI_PROVIDER_REPORT=groq
# AI_PROVIDER_ROADMAP=groq

# ==== RAG / Embeddings ====
# "gemini" uses the Gemini embeddings API (requires GEMINI_API_KEY, free tier).
# "local" uses a deterministic hashing embedding — no key required, useful for
# local development. Auto-detected when unset: gemini if a key exists, else local.
# EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=gemini-embedding-001
# Number of chunks retrieved per RAG query.
# VECTOR_TOP_K=6

# ==== RAG ingestion ====
# One-time ingestion of the checked-in knowledge base (dev only):
#   curl -X POST http://localhost:3000/api/rag/ingest -H "Content-Type: application/json" -H "Authorization: Bearer <clerk_jwt>" -d '{"source":"all"}'
#
# Vector store backend: MongoDB. On Atlas, create a vector search index named
# "vector_index" on the "knowledgedocuments" collection, path "embedding",
# dimensions matching the embedding model (3072 for gemini-embedding-001 as
# returned by the API, 384 for the local provider). Without the index the
# service transparently
# falls back to in-process cosine similarity over the same collection.
